{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "project-1",
  "version": "0.1.0",
  "identifier": "com.project-1.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "project-1",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "centered": true
      }
    ],
    "security": {
      "csp": null
    },
    "plugins": {
      "shell": {
        "open": true
      },
      "dialog": {
        "all": true
      },
      "fs": {
        "all": true
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "2024 Your Name",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
